{
  "git": {
    "commit": false,
    "tag": true,
    "tagName": "v${version}",
    "push": true,
    "requireUpstream": false,
    "requireCleanWorkingDir": true
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "web": false
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "after:release": "sh scripts/publish.sh"
  }
}
