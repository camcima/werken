{
  "name": "@werken/cloudevents",
  "version": "0.5.0",
  "description": "CloudEvents 1.0 envelope types, validation, and Pub/Sub attribute binding. Zero runtime dependencies.",
  "keywords": [
    "cloudevents",
    "pubsub",
    "events",
    "typescript"
  ],
  "author": "Carlos Cima",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/camcima/werken#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camcima/werken.git",
    "directory": "packages/cloudevents"
  },
  "bugs": {
    "url": "https://github.com/camcima/werken/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build"
  }
}
